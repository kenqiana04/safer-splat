{
  "$id": "safer-splat://l2-h1/formal-run-id-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "identity_equation": "run_id == formal-v1-trial-{trial_id:03d}-attempt-{attempt_id}",
  "namespace_disjoint_from_qa": true,
  "overwrite_prior_attempt": false,
  "properties": {
    "artifact_root": {
      "pattern": "^formal-v1/trial-0[0-9]{2}/attempt-[01]/$",
      "type": "string"
    },
    "attempt_id": {
      "enum": [
        0,
        1
      ],
      "type": "integer"
    },
    "data_role": {
      "const": "FORMAL_PROSPECTIVE_SHADOW_COHORT_V1"
    },
    "protocol_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^formal-v1-trial-0[0-9]{2}-attempt-[01]$",
      "type": "string"
    },
    "trial_id": {
      "maximum": 99,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "trial_id",
    "run_id",
    "attempt_id",
    "protocol_sha",
    "data_role",
    "artifact_root"
  ],
  "title": "L2/H1 formal prospective shadow run identity V1",
  "type": "object"
}
