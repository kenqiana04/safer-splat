{
  "schema": "ACTIVE_RUNTIME_V3_PAIRED_EXECUTION_R1_EVIDENCE_SCHEMA_V1",
  "per_trial_required": [
    "trial_summary.json",
    "runtime_trace.jsonl",
    "runtime_trace_lock.json",
    "cycle_observations.jsonl",
    "process_exit_code.txt",
    "gpu_released.txt",
    "stdout.log",
    "stderr.log",
    "ACTIVE_V3_RAW_EVIDENCE_LOCK.json"
  ],
  "required_integrity_fields": [
    "selected_executed_identity_mismatch_count",
    "nonfinite_count",
    "action_bound_violation_count",
    "evidence_incomplete_count",
    "recovery_required_count",
    "plant_outcome_unknown_count",
    "duplicate_trace_append_count",
    "duplicate_plant_commit_count",
    "exception_count",
    "cuda_oom_count",
    "FORBIDDEN_DIAGNOSTIC_AUTHORITY_EVENT_COUNT"
  ],
  "trace_contract": "completed_cycles == trace_record_count == trace_lock_record_count == persisted_trace_lines",
  "legitimate_boundary_cycle": "one trace, zero plant commits, not evidence failure",
  "cycle_observation_role": "TASK_LOCAL_READ_ONLY_RUNTIME_FACT_CAPTURE_FOR_POSTHOC_ORACLE",
  "observer_feedback": false,
  "immutable_complete_evidence_required_for_resume_skip": true,
  "batch_child_authorization": {
    "scope": "ONE_CHILD_OF_AUTHORIZED_BATCH_ONLY",
    "bindings": [
      "exact_result_root",
      "execution_lock_sha256",
      "source_git_head",
      "branch",
      "protocol_sha256",
      "live_parent_pid",
      "one_time_token_sha256"
    ],
    "manual_one_without_authority_rejected": true,
    "wrong_result_root_rejected": true
  },
  "early_child_failure_before_raw_directory": {
    "location": "parent_failures/trial_<trial_id>/",
    "preserves": [
      "stdout.log",
      "stderr.log",
      "process_exit_code.txt",
      "gpu_released.txt",
      "EARLY_CHILD_FAILURE.json"
    ],
    "typed_hard_stop": true,
    "automatic_retry": false,
    "trial_evidence_lock_created": false,
    "completed_scientific_trial_count_increment": 0
  },
  "aggregate_scientific_analysis_during_collection": false
}
