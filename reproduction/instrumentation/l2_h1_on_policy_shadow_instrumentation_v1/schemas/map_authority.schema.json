{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safer-splat://l2-h1-shadow-instrumentation/map-authority-v1",
  "type": "object",
  "required": ["schema_version", "logical_map_name", "artifacts", "representation_contract", "robot_radius", "safety_margin", "effective_radius", "rho_seg", "map_authority_id", "full_map_hash_call_count_per_run", "per_step_full_map_hash_count"],
  "properties": {
    "schema_version": {"const": "MAP_AUTHORITY_MANIFEST_V1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "size", "sha256"],
        "properties": {
          "relative_path": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "map_authority_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_map_hash_call_count_per_run": {"const": 1},
    "per_step_full_map_hash_count": {"const": 0}
  }
}
