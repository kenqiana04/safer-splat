{
  "schema_version": "BACKUP_TOKEN_ADVERSARIAL_SCENARIOS_V2",
  "scenarios": [
    {"id": "BT-S01", "case": "primary witness plus commit success", "expected": "NEW_TOKEN_ACTIVE_AT_K_PLUS_1"},
    {"id": "BT-S02", "case": "witness plus commit abort", "expected": "OLD_RETAINED_NEW_ABORTED"},
    {"id": "BT-S03", "case": "alternative witness not selected", "expected": "PREPARED_NEVER_ACTIVE"},
    {"id": "BT-S04", "case": "selected alternative commits", "expected": "SELECTED_BUNDLE_ACTIVE_AT_K_PLUS_1"},
    {"id": "BT-S05", "case": "exact state match", "expected": "BACKUP_ELIGIBLE"},
    {"id": "BT-S06", "case": "state mismatch", "expected": "TOKEN_INVALID"},
    {"id": "BT-S07", "case": "map mismatch", "expected": "TOKEN_INVALID"},
    {"id": "BT-S08", "case": "actuator mismatch", "expected": "TOKEN_INVALID"},
    {"id": "BT-S09", "case": "geometry mismatch", "expected": "TOKEN_INVALID"},
    {"id": "BT-S10", "case": "deadline expired with valid token", "expected": "RETAINED_BACKUP_SELECTABLE"},
    {"id": "BT-S11", "case": "deadline expired without token", "expected": "NO_NEW_DISCOVERY"},
    {"id": "BT-S12", "case": "same backup action twice", "expected": "SECOND_CONSUME_REJECTED"},
    {"id": "BT-S13", "case": "cursor advance before commit", "expected": "ADVANCE_REJECTED"},
    {"id": "BT-S14", "case": "last action consumed", "expected": "EXHAUSTED_TERMINAL_REF_ONLY"},
    {"id": "BT-S15", "case": "terminal ref exists but policy unresolved", "expected": "NO_AUTOMATIC_TERMINAL_COMMIT"},
    {"id": "BT-S16", "case": "first cycle no prior token and incomplete candidate", "expected": "ASSURANCE_BOUNDARY"},
    {"id": "BT-S17", "case": "new witness pending while old valid", "expected": "OLD_TOKEN_RETAINED"},
    {"id": "BT-S18", "case": "prepared bundle corrupted", "expected": "OLD_RETAINED_CORRUPT_REJECTED"},
    {"id": "BT-S19", "case": "source candidate vector changes", "expected": "PREPARED_ABORTED_IDENTITY_CHANGE"},
    {"id": "BT-S20", "case": "dynamics timebase drift", "expected": "TOKEN_INVALID"}
  ]
