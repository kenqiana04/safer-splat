{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMMUTABLE_BACKUP_CERTIFICATE_BUNDLE_V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "canonical_bundle_sha256", "l3_witness_id", "source_candidate_id", "source_candidate_identity_sha256", "source_candidate_role", "source_candidate_provenance_authority", "certification_chain", "certification_cycle_k", "predicted_start_state_identity_x_k_plus_1", "backup_tail_control_sequence", "predicted_state_sequence", "certified_segment_evidence_refs", "terminal_witness_ref", "map_authority_id", "geometry_contract_id", "geometry_contract_sha256", "actuator_contract_id", "actuator_contract_sha256", "dynamics_timebase_id", "deadline_contract_id", "candidate_source_contract_id", "temporal_index_contract_id", "backend_query_identities", "no_error_theorem_assumptions", "bundle_creation_status"],
  "properties": {
    "schema_version": {"const": "IMMUTABLE_BACKUP_CERTIFICATE_BUNDLE_V2"},
    "bundle_id": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "canonical_bundle_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "l3_witness_id": {"type": "string", "minLength": 1},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "source_candidate_identity_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "source_candidate_role": {"enum": ["PRIMARY", "ALTERNATIVE"]},
    "source_candidate_provenance_authority": {"type": "string", "minLength": 1},
    "certification_chain": {"type": "object", "required": ["C0", "L1", "L2", "L3", "evidence_refs"], "properties": {"C0": {"const": "PASS"}, "L1": {"const": "FRESH_BOUND_PASS"}, "L2": {"const": "PASS"}, "L3": {"const": "WITNESS_FOUND"}, "evidence_refs": {"type": "array", "minItems": 4, "items": {"type": "string"}}}},
    "certification_cycle_k": {"type": "integer", "minimum": 0},
    "predicted_start_state_identity_x_k_plus_1": {"type": "string", "minLength": 1},
    "backup_tail_control_sequence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["tail_index", "control_identity"], "properties": {"tail_index": {"type": "integer", "minimum": 0}, "control_identity": {"type": "string", "minLength": 1}}}},
    "predicted_state_sequence": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "certified_segment_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "terminal_witness_ref": {"type": ["object", "null"]},
    "map_authority_id": {"const": "STATIC_IMMUTABLE_REPRESENTED_GAUSSIAN_MAP_AUTHORITY"},
    "geometry_contract_id": {"const": "CERTIFICATION_GEOMETRY_AUTHORITY_V2"},
    "geometry_contract_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "actuator_contract_id": {"const": "NORMATIVE_COMPONENTWISE_ACCELERATION_AUTHORITY_V2"},
    "actuator_contract_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "dynamics_timebase_id": {"const": "POSITION_FIRST_FORWARD_EULER_DOUBLE_INTEGRATOR_V1"},
    "deadline_contract_id": {"const": "RUNTIME_DEADLINE_AUTHORITY"},
    "candidate_source_contract_id": {"const": "ALTERNATIVE_SOURCE_AUTHORITY"},
    "temporal_index_contract_id": {"const": "TEMPORAL_INDEX_CONTRACT_V2"},
    "backend_query_identities": {"type": "array", "items": {"type": "string"}},
    "no_error_theorem_assumptions": {"type": "array", "items": {"enum": ["STATIC_MAP_SNAPSHOT", "NO_MODELING_DISTURBANCE", "NO_ACTUATION_DELAY", "NO_TRACKING_ERROR", "EXACT_FROZEN_MODEL_STATE_ALIGNMENT"]}},
    "bundle_creation_status": {"const": "COMPLETE"}
  },
  "canonical_hash_material": "all required fields except bundle_id and canonical_bundle_sha256; UTF-8 canonical JSON, sorted keys, compact separators",
  "partial_witness_allowed": false,
  "commit_authority": false,
  "mutable_after_creation": false
}
